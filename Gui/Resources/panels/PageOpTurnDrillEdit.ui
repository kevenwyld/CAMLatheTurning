<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Form</class>
 <widget class="QWidget" name="Form">
  <property name="windowTitle"><string>Form</string></property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0"><widget class="QCheckBox" name="setHoleStart"><property name="toolTip"><string>Z where the hole starts. Unticked: the selected hole's front, or with nothing selected the part's front, shown greyed out</string></property><property name="text"><string>Hole start</string></property></widget></item>
   <item row="0" column="1"><widget class="Gui::QuantitySpinBox" name="holeStart"><property name="toolTip"><string>Z where the hole starts</string></property><property name="minimum"><double>-100000.000000000000000</double></property><property name="maximum"><double>100000.000000000000000</double></property></widget></item>
   <item row="1" column="0"><widget class="QCheckBox" name="setHoleDepth"><property name="toolTip"><string>Depth of the hole from its start. Unticked: the selected hole's, shown greyed out; with nothing selected, tick it and set it</string></property><property name="text"><string>Hole depth</string></property></widget></item>
   <item row="1" column="1"><widget class="Gui::QuantitySpinBox" name="holeDepth"><property name="toolTip"><string>Depth of the hole from its start</string></property><property name="minimum"><double>0.000000000000000</double></property></widget></item>
   <item row="2" column="0"><widget class="QLabel" name="label_cycle"><property name="text"><string>Cycle</string></property></widget></item>
   <item row="2" column="1"><widget class="QComboBox" name="cycle"><property name="toolTip"><string>Peck (G83): back out of the hole after each peck; Chip break (G73): back off a little; Drill (G81): straight to depth; Dwell (G82): to depth, then a dwell</string></property></widget></item>
   <item row="3" column="0"><widget class="QLabel" name="label_peck"><property name="text"><string>Peck depth</string></property></widget></item>
   <item row="3" column="1"><widget class="Gui::QuantitySpinBox" name="peckDepth"><property name="toolTip"><string>Depth of each peck (Peck and Chip break)</string></property><property name="minimum"><double>0.000000000000000</double></property></widget></item>
   <item row="4" column="0"><widget class="QLabel" name="label_dwell"><property name="text"><string>Dwell (s)</string></property></widget></item>
   <item row="4" column="1"><widget class="QDoubleSpinBox" name="dwellTime"><property name="toolTip"><string>Seconds at the bottom (Dwell)</string></property><property name="decimals"><number>2</number></property><property name="maximum"><double>60.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property></widget></item>
   <item row="5" column="0"><widget class="QLabel" name="label_retract"><property name="text"><string>Retract height</string></property></widget></item>
   <item row="5" column="1"><widget class="Gui::QuantitySpinBox" name="retractHeight"><property name="toolTip"><string>Distance in front of the hole where each peck starts and the drill retracts to (the R plane)</string></property><property name="minimum"><double>0.000000000000000</double></property></widget></item>
   <item row="6" column="0" colspan="2"><widget class="QCheckBox" name="depthToTip"><property name="toolTip"><string>Drill to the tip: the drill's point reaches the bottom of the selected hole. Off: its full diameter does, so the point goes deeper by its length</string></property><property name="text"><string>Depth to the drill's tip</string></property></widget></item>
   <item row="7" column="0" colspan="2"><widget class="QCheckBox" name="useCannedCycle"><property name="toolTip"><string>Write the cycle as a canned cycle (G81/G82/G83/G73, in G17, then back to G18); off: the same moves written out</string></property><property name="text"><string>Use a canned cycle</string></property></widget></item>
   <item row="8" column="0" colspan="2"><widget class="QLabel" name="drillReport"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Select the hole to drill (its cylindrical face) on the Z Range page.</string></property></widget></item>
   <item row="9" column="0"><spacer name="verticalSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
  </layout>
 </widget>
 <customwidgets><customwidget><class>Gui::QuantitySpinBox</class><extends>QWidget</extends><header>Gui/QuantitySpinBox.h</header></customwidget></customwidgets>
